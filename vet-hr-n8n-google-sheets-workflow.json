      "parameters": {
        "jsCode": "const HOSPITAL_LAT=32.58591,HOSPITAL_LNG=44.02225,RADIUS_METERS=300;\nfunction hav(a,b,c,d){const R=6371000,dL=(c-a)*Math.PI/180,dl=(d-b)*Math.PI/180,x=Math.sin(dL/2)**2+Math.cos(a*Math.PI/180)*Math.cos(c*Math.PI/180)*Math.sin(dl/2)**2;return R*2*Math.atan2(Math.sqrt(x),Math.sqrt(1-x));}\nconst body=$input.item.json.body||$input.item.json;\nconst {empId,empName,lat,lng,action,dept,telegramId}=body;\nif(!empId||!lat||!lng) return [{json:{ok:false,message:\"بيانات ناقصة\",empId,action}}];\nconst distance=Math.round(hav(parseFloat(lat),parseFloat(lng),HOSPITAL_LAT,HOSPITAL_LNG));\nif(distance>RADIUS_METERS) return [{json:{ok:false,message:\"خارج نطاق المستشفى — \"+distance+\" متر\",empId,empName,distance,action}}];\nconst iraqTime=new Date(Date.now()+3*3600000);\nconst timeStr=iraqTime.toISOString().substr(11,5),dateStr=iraqTime.toISOString().substr(0,10);\nreturn [{json:{ok:true,empId,empName:empName||empId,dept:dept||\"\",telegramId:telegramId||\"\",lat:parseFloat(lat),lng:parseFloat(lng),distance,timeStr,dateStr,action:action||\"checkin\"}}];"
      },
