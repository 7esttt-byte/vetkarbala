        "jsCode": "const g = $(\"Code — التحقق من GPS\").item.json;\nconst empList = $input.all();\n\nif (empList.length === 0) {\n  return [{ json: { ok: false, message: \"الموظف \" + g.empId + \" غير موجود في النظام\" } }];\n}\n\nconst emp = empList[0].json;\n\nreturn [{ \n  json: { \n    ok: true, \n    empId: emp.emp_id, \n    empName: emp.full_name, \n    dept: emp.dept || \"\", \n    telegramId: emp.telegram_id || g.telegramId || \"\", \n    lat: g.lat, \n    lng: g.lng, \n    distance: g.distance, \n    timeStr: g.timeStr, \n    dateStr: g.dateStr, \n    action: g.action, \n    branch: g.branch, \n    branchId: g.branchId \n  } \n}];"
