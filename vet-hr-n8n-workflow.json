        "jsCode": "const ad = $(\"Code — معالجة القرار\").item.json;\nconst leaves = $input.all();\n\nif (leaves.length === 0) {\n  return [{ json: { ok: false, message: `طلب الإجازة ذو المعرف ${ad.leaveId} غير موجود` } }];\n}\n\nconst leave = leaves[0].json;\n\nreturn [{ \n  json: { \n    ok: true, \n    \"معرف الإجازة\": leave.leave_id, \n    \"الحالة\": ad.newStatus, \n    \"موافقة المدير\": ad.managerName, \n    \"تاريخ القرار\": ad.decisionAt, \n    \n    // Pass other details for downstream nodes\n    leaveId: leave.leave_id,\n    empId: leave.emp_id,\n    empName: leave.emp_name,\n    dept: leave.dept,\n    telegramId: leave.telegram_id,\n    type: leave.leave_type,\n    startDate: leave.start_date,\n    endDate: leave.end_date,\n    hours: leave.hours,\n    reason: leave.reason,\n    action: ad.action,\n    newStatus: ad.newStatus,\n    managerName: ad.managerName,\n    decisionAt: ad.decisionAt\n  } \n}];"
