    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\nconst { empId, empName, dept, type, startDate, endDate, hours, reason, telegramId } = body;\n\nif (!empId || !type || !startDate || !reason) {\n  return [{ json: { ok: false, message: \"بيانات ناقصة في طلب الإجازة\" } }];\n}\n\nconst iraqTime = new Date(Date.now() + 3 * 3600000);\nconst reqAt = iraqTime.toISOString().substr(0, 16).replace(\"T\", \" \");\nconst leaveId = \"LV-\" + Date.now();\n\nlet leaveType = \"\";\nif (type === \"regular\") leaveType = \"اعتيادية\";\nelse if (type === \"timed\") leaveType = \"زمنية\";\nelse leaveType = type;\n\nif (type === \"timed\" && (!hours || parseInt(hours) < 1 || parseInt(hours) > 8)) {\n  return [{ json: { ok: false, message: \"الإجازة الزمنية: الساعات يجب بين 1 و 8\" } }];\n}\n\nreturn [{ \n  json: { \n    ok: true, \n    \"معرف الإجازة\": leaveId, \n    \"رقم الموظف\": empId, \n    \"اسم الموظف\": empName || empId, \n    \"القسم\": dept || \"\", \n    \"نوع الإجازة\": leaveType, \n    \"تاريخ البداية\": startDate, \n    \"تاريخ النهاية\": type === \"timed\" ? startDate : (endDate || startDate), \n    \"عدد الساعات\": type === \"timed\" ? parseInt(hours) : null, \n    \"السبب\": reason, \n    \"الحالة\": \"بانتظار الموافقة\", \n    \"تاريخ الطلب\": reqAt, \n    \"موافقة المدير\": \"\", \n    \"تاريخ القرار\": \"\", \n    \"تلغرام الموظف\": telegramId || \"\", \n    leaveId, \n    empId, \n    empName: empName || empId, \n    dept: dept || \"\", \n    telegramId: telegramId || \"\", \n    type, \n    startDate, \n    endDate: type === \"timed\" ? startDate : (endDate || startDate), \n    hours: type === \"timed\" ? parseInt(hours) : null, \n    reason, \n    reqAt \n  } \n}];"
      },
