    {
      "parameters": {
        "jsCode": "const LOCATIONS = [\n  { id: 'LOC1', name: 'مقر إدارة المستشفى البيطري (حي التعاون)',      lat: 32.58591, lng: 44.02225, r: 150 },\n  { id: 'LOC2', name: 'بناية مختبر المستشفى البيطري (حي التعاون)',      lat: 32.58575, lng: 44.02240, r: 150 },\n  { id: 'LOC3', name: 'بناية شعبة العيادة الخارجية (حي التعاون)',    lat: 32.58610, lng: 44.02210, r: 150 }\n];\n\nfunction hav(a, b, c, d) {\n  const R = 6371000;\n  const dL = (c - a) * Math.PI / 180;\n  const dl = (d - b) * Math.PI / 180;\n  const x = Math.sin(dL / 2) ** 2 + Math.cos(a * Math.PI / 180) * Math.cos(c * Math.PI / 180) * Math.sin(dl / 2) ** 2;\n  return R * 2 * Math.atan2(Math.sqrt(x), Math.sqrt(1 - x));\n}\n\nconst body = $input.item.json.body || $input.item.json;\nconst { empId, empName, lat, lng, action, dept, telegramId } = body;\n\nif (!empId || !lat || !lng) {\n  return [{ json: { ok: false, message: \"بيانات ناقصة (رقم الموظف أو الإحداثيات)\", empId, action } }];\n}\n\nconst parsedLat = parseFloat(lat);\nconst parsedLng = parseFloat(lng);\n\nlet nearestBranch = null;\nlet minDistance = Infinity;\n\nfor (const loc of LOCATIONS) {\n  const d = Math.round(hav(parsedLat, parsedLng, loc.lat, loc.lng));\n  if (d < minDistance) {\n    minDistance = d;\n    nearestBranch = loc;\n  }\n}\n\nif (minDistance > nearestBranch.r) {\n  const allDists = LOCATIONS.map(l => `📌 ${l.name}: ${Math.round(hav(parsedLat, parsedLng, l.lat, l.lng))}م`).join(\" | \");\n  return [{ \n    json: { \n      ok: false, \n      message: `خارج نطاق جميع مباني المستشفى — الأقرب: ${minDistance}م لـ ${nearestBranch.name}. المسافات الحالية: [${allDists}]`, \n      empId, \n      empName, \n      distance: minDistance, \n      action \n    } \n  }];\n}\n\nconst iraqTime = new Date(Date.now() + 3 * 3600000);\nconst timeStr = iraqTime.toISOString().substr(11, 5);\nconst dateStr = iraqTime.toISOString().substr(0, 10);\n\nreturn [{ \n  json: { \n    ok: true, \n    empId, \n    empName: empName || empId, \n    dept: dept || \"\", \n    telegramId: telegramId || \"\", \n    lat: parsedLat, \n    lng: parsedLng, \n    distance: minDistance, \n    branch: nearestBranch.name,\n    branchId: nearestBranch.id,\n    timeStr, \n    dateStr, \n    action: action || \"checkin\" \n  } \n}];"
      },
