        "jsCode": "const emp = $(\"Code — مطابقة الموظف\").item.json;\nconst attList = $input.all();\n\nconst rec = attList.length > 0 ? attList[0].json : null;\n\nlet workedHours = null;\nif (emp.action === \"checkout\" && rec && rec.check_in) {\n  const [h1, m1] = String(rec.check_in).split(\":\").map(Number);\n  const [h2, m2] = emp.timeStr.split(\":\").map(Number);\n  const mins = (h2 * 60 + m2) - (h1 * 60 + m1);\n  if (mins > 0) {\n    workedHours = Math.floor(mins / 60) + \"س \" + (mins % 60) + \"د\";\n  }\n}\n\nreturn [{ \n  json: { \n    ...emp, \n    existingRecord: rec, \n    isNewRecord: !rec, \n    workedHours \n  } \n}];"
      },
