    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\nconst { leaveId, action, managerId, managerName } = body;\n\nif (!leaveId || !action) {\n  return [{ json: { ok: false, message: \"بيانات ناقصة (leaveId و action مطلوبان)\" } }];\n}\n\nconst iraqTime = new Date(Date.now() + 3 * 3600000);\nconst decisionAt = iraqTime.toISOString().substr(0, 16).replace(\"T\", \" \");\nconst newStatus = (action === \"approve\") ? \"مقبولة\" : \"مرفوضة\";\nconst managerDecision = managerName || \"المدير\";\n\nreturn [{ \n  json: { \n    ok: true, \n    leaveId, \n    action, \n    newStatus, \n    managerId: managerId || \"MGR\", \n    managerName: managerDecision, \n    decisionAt \n  } \n}];"
